{
  "name": "fifo-securities-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "单币种证券 FIFO 成本批次与部分卖出盈亏核算后端（API + CLI）",
  "type": "module",
  "bin": {
    "fifo-ledger": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --no-warnings \"dist/test/**/*.test.js\"",
    "start": "node --no-warnings dist/server.js",
    "demo": "node --no-warnings dist/cli/index.js demo",
    "cli": "node --no-warnings dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.9.0"
  }
}
